{
	code: "eartag",
	class: "ItemEarTag",
	// Sneak + place to stack tags on the ground, four to a layer, up to 32. Pure JSON - vanilla
	// metalplate does exactly this, so no block and no code is needed.
	//
	// THE RATIO IS 4 BECAUSE A TAG IS FOUR BOXES. The renderer walks the pile shape's elements
	// FLATTENED - children count the same as parents - and reveals stackSize x ratio of them. At
	// ratio 1 a tag came out a quarter at a time: one box for one tag, four tags' worth of items
	// for the first whole one.
	//
	// The rule vanilla follows is: total flattened elements = stackingCapacity x ratio. Here that
	// is 32 x 4 = 128, which is what the pile shape has (32 tags of 4 boxes). beeswax-pile is the
	// same idea at 24 boxes a lump; platepile is the trivial case at one box a plate.
	behaviors: [{
		name: "GroundStorable",
		properties: {
			layout: "Stacking",
			upSolid: true,
			placeRemoveSound: "sounds/block/leather",
			stackingModel: "eartags:block/eartagpile",
			stackingTextures: {
				"tag": "eartags:block/leather/{color}"
			},
			collisionBox: { x1: 0.03, y1: 0, z1: 0.03, x2: 0.97, y2: 0.0625, z2: 0.97 },
			cbScaleYByLayer: 0.25,
			modelItemsToStackSizeRatio: 4,
			stackingCapacity: 32,
			transferQuantity: 1,
			bulkTransferQuantity: 4
		}
	}],
	variantgroups: [
		{ code: "color", states: [ "orange", "black", "red", "blue", "purple", "pink", "white", "yellow", "gray", "green" ] }
	],
	shape: { base: "eartags:item/eartag" },
	textures: {
		"tag": { base: "eartags:block/leather/{color}" }
	},
	creativeinventory: { "general": ["*"], "items": ["*"] },
	maxstacksize: 64,
	materialDensity: 300,
	attributes: {
		handbook: {
			groupBy: ["eartag-*"]
		}
	},
	guiTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: -72, y: 18, z: -6 },
		origin: { x: 0.5, y: 0.023, z: 0.5 },
		scale: 1.9
	},
	fpHandTransform: {
		translation: { x: 0.1, y: 0.2, z: -0.4 },
		rotation: { x: 0, y: -80, z: -20 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 1
	},
	tpHandTransform: {
		translation: { x: -0.15, y: 0.05, z: -0.5 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 0.5
	},
	groundTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 1.55
	}
}
