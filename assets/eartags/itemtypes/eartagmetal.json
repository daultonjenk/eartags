{
	// The metal tag. Same class, same shape, same interaction as the leather one - ItemEarTag reads
	// the material off the last code part and the kind off the first, so "eartagmetal-copper" needs
	// no code of its own.
	//
	// The variant list is loaded from the same world property vanilla metalplate uses, so the two
	// cannot drift apart: every metal you can beat into a plate, you can cut a tag from.
	//
	// Texture is the ingot art rather than the plate art. That is what metalplate itself uses, and
	// it is the one metal folder with an image for every variant of the property.
	code: "eartagmetal",
	class: "ItemEarTag",
	// See eartag.json.
	//
	// Gold gets its own pile shape at reflectiveMode 3 where everything else sits at 2, which is
	// exactly how vanilla singles out gold ingot piles - stackingModelByType, same as ingot.json.
	// There is no shininess property on a metal to read; vanilla hard-codes gold and so do we.
	//
	// Note the drop from the 4 the tag wears on an animal. On an ear it hangs vertically and moves;
	// on the ground every tag is a flat face pointed straight at the sky, and 4 turned a stack of
	// silver into a mirror. Vanilla does the same thing - a held gold ingot is 4, its pile is 3.
	behaviors: [{
		name: "GroundStorable",
		properties: {
			layout: "Stacking",
			upSolid: true,
			placeRemoveSound: "sounds/block/ingot",
			stackingModelByType: {
				"*-gold": "eartags:block/eartagpile-shiny",
				"*": "eartags:block/eartagpile-metal"
			},
			stackingTextures: {
				"tag": "game:block/metal/ingot/{metal}"
			},
			collisionBox: { x1: 0.03, y1: 0, z1: 0.03, x2: 0.97, y2: 0.0625, z2: 0.97 },
			cbScaleYByLayer: 0.25,
			modelItemsToStackSizeRatio: 1,
			stackingCapacity: 32,
			transferQuantity: 1,
			bulkTransferQuantity: 4
		}
	}],
	variantgroups: [
		{ code: "metal", loadFromProperties: "block/metal" }
	],
	shape: { base: "eartags:item/eartag" },
	textures: {
		"tag": { base: "game:block/metal/ingot/{metal}" }
	},
	creativeinventory: { "general": ["*"], "items": ["*"] },
	maxstacksize: 64,
	materialDensity: 600,
	attributes: {
		handbook: {
			groupBy: ["eartagmetal-*"]
		}
	},
	guiTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: -72, y: 18, z: -6 },
		origin: { x: 0.5, y: 0.023, z: 0.5 },
		scale: 1.9
	},
	fpHandTransform: {
		translation: { x: 0.1, y: 0.2, z: -0.4 },
		rotation: { x: 0, y: -80, z: -20 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 1
	},
	tpHandTransform: {
		translation: { x: -0.15, y: 0.05, z: -0.5 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 0.5
	},
	groundTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 1.55
	}
}
