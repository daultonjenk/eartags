[
	{
		file: "game:entities/animal/mammal/hooved/goat-adult",
		op: "add",
		path: "/client/behaviors/-",
		value: { code: "eartaggable" }
	},
	{
		file: "game:entities/animal/mammal/hooved/goat-adult",
		op: "add",
		path: "/server/behaviors/-",
		value: { code: "eartaggable" }
	},

	// See sheep-eartag-textures.json for why the tag textures have to be declared here rather than
	// registered at runtime.
	{
		file: "game:entities/animal/mammal/hooved/goat-adult",
		op: "add",
		path: "/client/textures",
		value: {
			"eartagorangetag": { base: "eartags:block/leather/orange" },
			"eartagblacktag":  { base: "eartags:block/leather/black" },
			"eartagredtag":    { base: "eartags:block/leather/red" },
			"eartagbluetag":   { base: "eartags:block/leather/blue" },
			"eartagpurpletag": { base: "eartags:block/leather/purple" },
			"eartagpinktag":   { base: "eartags:block/leather/pink" },
			"eartagwhitetag":  { base: "eartags:block/leather/white" },
			"eartagyellowtag": { base: "eartags:block/leather/yellow" },
			"eartaggraytag":   { base: "eartags:block/leather/gray" },
			"eartaggreentag":  { base: "eartags:block/leather/green" }
		}
	},

	// The angora and the mountain goat are the only two breeds goat-adult.json gives a
	// texturesByType entry, and the game resolves a *ByType property by picking the matching
	// branch and writing it over its plain sibling. On those two breeds that would drop the block
	// added above and the tags would render blank, so add the same ten codes into their branches
	// as well. Adding each key on its own rather than replacing the whole branch leaves the
	// vanilla hide/hair entries alone, so this survives a change to them upstream.
	//
	// This is belt and braces: if the resolver turns out to merge rather than replace, these
	// duplicate the values already present and cost nothing.
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartagorangetag", value: { base: "eartags:block/leather/orange" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartagblacktag",  value: { base: "eartags:block/leather/black" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartagredtag",    value: { base: "eartags:block/leather/red" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartagbluetag",   value: { base: "eartags:block/leather/blue" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartagpurpletag", value: { base: "eartags:block/leather/purple" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartagpinktag",   value: { base: "eartags:block/leather/pink" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartagwhitetag",  value: { base: "eartags:block/leather/white" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartagyellowtag", value: { base: "eartags:block/leather/yellow" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartaggraytag",   value: { base: "eartags:block/leather/gray" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-angora-*/eartaggreentag",  value: { base: "eartags:block/leather/green" } },

	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartagorangetag", value: { base: "eartags:block/leather/orange" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartagblacktag",  value: { base: "eartags:block/leather/black" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartagredtag",    value: { base: "eartags:block/leather/red" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartagbluetag",   value: { base: "eartags:block/leather/blue" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartagpurpletag", value: { base: "eartags:block/leather/purple" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartagpinktag",   value: { base: "eartags:block/leather/pink" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartagwhitetag",  value: { base: "eartags:block/leather/white" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartagyellowtag", value: { base: "eartags:block/leather/yellow" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartaggraytag",   value: { base: "eartags:block/leather/gray" } },
	{ file: "game:entities/animal/mammal/hooved/goat-adult", op: "add", path: "/client/texturesByType/goat-mountain-*/eartaggreentag",  value: { base: "eartags:block/leather/green" } }
]
