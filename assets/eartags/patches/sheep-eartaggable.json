[
	// The server copy goes in at index 0, not appended. Entity.ReceiveDamage walks the behaviour
	// list in order handing each one the damage by ref, and EntityBehaviorHealth is the one that
	// actually subtracts it - so a metal tag can only zero the damage if this behaviour is reached
	// first. Vanilla puts "health" fifth in the list; appending would put us about twentieth, well
	// after the animal had already taken the hit.
	//
	// The client copy is only there to render the tag, so its position does not matter.
	{
		file: "game:entities/animal/mammal/hooved/sheep-adult",
		op: "add",
		path: "/client/behaviors/-",
		value: { code: "eartaggable" }
	},
	{
		file: "game:entities/animal/mammal/hooved/sheep-adult",
		op: "add",
		path: "/server/behaviors/0",
		value: { code: "eartaggable" }
	}
]
