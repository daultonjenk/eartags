[
	// Declares the ear tag textures on the animal itself so the engine BAKES them into the entity
	// texture atlas at asset-load time, exactly as it does for the animal's own hide.
	//
	// Registering a texture at runtime (atlas insert + a hand-built BakedCompositeTexture) produces
	// an entry that looks correct in every observable way - asset resolves, real atlas position,
	// no missing-mapping error - but still does not render. Declaring it here instead means we
	// never do runtime texture work at all; the behavior's registration path no-ops because the
	// code is already present.
	//
	// The key must match texturePrefixCode + the tag shape's texture code, i.e. the tag item's own
	// code ("eartag" or "eartagmetal") + the material + "tag".
	//
	// Metal tags borrow the ingot textures rather than the plate ones, because that is what vanilla
	// metalplate uses for itself and it is the one metal folder that covers every variant of the
	// block/metal world property.
	{
		file: "game:entities/animal/mammal/hooved/sheep-adult",
		op: "add",
		path: "/client/textures",
		value: {
			"eartagorangetag":              { base: "eartags:block/leather/orange" },
			"eartagblacktag":               { base: "eartags:block/leather/black" },
			"eartagredtag":                 { base: "eartags:block/leather/red" },
			"eartagbluetag":                { base: "eartags:block/leather/blue" },
			"eartagpurpletag":              { base: "eartags:block/leather/purple" },
			"eartagpinktag":                { base: "eartags:block/leather/pink" },
			"eartagwhitetag":               { base: "eartags:block/leather/white" },
			"eartagyellowtag":              { base: "eartags:block/leather/yellow" },
			"eartaggraytag":                { base: "eartags:block/leather/gray" },
			"eartaggreentag":               { base: "eartags:block/leather/green" },
			"eartagmetalbismuthtag":        { base: "game:block/metal/ingot/bismuth" },
			"eartagmetalbismuthbronzetag":  { base: "game:block/metal/ingot/bismuthbronze" },
			"eartagmetalblackbronzetag":    { base: "game:block/metal/ingot/blackbronze" },
			"eartagmetalbrasstag":          { base: "game:block/metal/ingot/brass" },
			"eartagmetalchromiumtag":       { base: "game:block/metal/ingot/chromium" },
			"eartagmetalcoppertag":         { base: "game:block/metal/ingot/copper" },
			"eartagmetalcupronickeltag":    { base: "game:block/metal/ingot/cupronickel" },
			"eartagmetalelectrumtag":       { base: "game:block/metal/ingot/electrum" },
			"eartagmetalgoldtag":           { base: "game:block/metal/ingot/gold" },
			"eartagmetalirontag":           { base: "game:block/metal/ingot/iron" },
			"eartagmetalleadtag":           { base: "game:block/metal/ingot/lead" },
			"eartagmetalmeteoricirontag":   { base: "game:block/metal/ingot/meteoriciron" },
			"eartagmetalmolybdochalkostag": { base: "game:block/metal/ingot/molybdochalkos" },
			"eartagmetalnickeltag":         { base: "game:block/metal/ingot/nickel" },
			"eartagmetalplatinumtag":       { base: "game:block/metal/ingot/platinum" },
			"eartagmetalsilvertag":         { base: "game:block/metal/ingot/silver" },
			"eartagmetalstainlesssteeltag": { base: "game:block/metal/ingot/stainlesssteel" },
			"eartagmetalsteeltag":          { base: "game:block/metal/ingot/steel" },
			"eartagmetaltintag":            { base: "game:block/metal/ingot/tin" },
			"eartagmetaltinbronzetag":      { base: "game:block/metal/ingot/tinbronze" },
			"eartagmetaltitaniumtag":       { base: "game:block/metal/ingot/titanium" },
			"eartagmetaluraniumtag":        { base: "game:block/metal/ingot/uranium" },
			"eartagmetalzinctag":           { base: "game:block/metal/ingot/zinc" }
		}
	}
]
